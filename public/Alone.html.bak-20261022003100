                    // Validate length.
                    if (
                        enteredSeed.length !==
                        SEED_SETTINGS_LENGTH + SEED_RANDOM_LENGTH
                    ) {
                        throw new Error(
                            `Invalid world seed. Expected ${SEED_SETTINGS_LENGTH + SEED_RANDOM_LENGTH} characters.`
                        );
                    }

                    // Store the complete seed.
                    currentWorldSeed = enteredSeed;

                    // The RANDOM half determines the actual
                    // world-generation randomness.
                    const randomPart =
                        enteredSeed.substring(SEED_SETTINGS_LENGTH);

                    worldSeed =
                        seedStringToNumber(randomPart);

                    // Reset deterministic random sequence.
                    currentRandomState = worldSeed;
                }

                console.log("NUMERIC WORLD SEED:", worldSeed);



                // -------------------------------------------------
                // EXISTING GENERATION SETUP
                // -------------------------------------------------

                if (typeof updateWorldDimensions === 'function') {
                    updateWorldDimensions();
                }

                if (
                    typeof ROWS === 'undefined' ||
                    typeof COLS === 'undefined' ||
                    isNaN(ROWS) ||
                    isNaN(COLS)
                ) {
                    throw new Error(
                        "ROWS or COLS is not a valid number."
                    );
                }

                worldGrid = new Array(ROWS);

                for (let y = 0; y < ROWS; y++) {
                    worldGrid[y] =
                        new Array(COLS).fill('OCEAN');
                }

                mapTerrainDirty = true;

                // IMPORTANT:
                // This must remain AFTER worldSeed was initialized.
                currentRandomState = worldSeed;

                resourceNodes = [];
                mobs = [];
                buildings = [];

                generationState = {
                    active: true,
                    fromSave,
                    stepIndex: 0,
                    yTracker: 0,
                    forestIndex: 0,
                    mountainIndex: 0,
                    totalForests: 0,
                    totalMountains: 0,
                    ctx: null
                };

                generationState.ctx = {
                    occupancy: new Uint8Array(COLS * ROWS),

                    cX: COLS / 2,
                    cY: ROWS / 2,

                    mapPreset:
                        worldConfig.mapPreset || 'standard',

                    oceanScale:
                        Math.max(
                            0.1,
                            Number(worldConfig.oceanMult || 1)
                        ),

                    removesOcean:
                        ['dry', 'inland', 'riverlands']
                            .includes(
                                worldConfig.mapPreset || 'standard'
                            ),

                    forestScale:
                        Math.max(
                            0.01,
                            Number(worldConfig.forestMult || 1)
                        ),

                    mountainScale:
                        Math.max(
                            0.01,
                            Number(worldConfig.mountainMult || 1)
                        ),

                    LIQUIDS: new Set([
                        'OCEAN',
                        'LAKE',
                        'RIVER',
                        'BAY',
                        'GULF',
                        'SHALLOW_WATER'
                    ]),

                    isDryOrInland:
                        ['dry', 'inland']
                            .includes(
                                worldConfig.mapPreset || 'standard'
                            ),

                    isBarrenZone: (x, y) => {

                        const patch =
                            Math.sin(
                                x * 0.021 +
                                worldSeed * 0.001
                            ) +
                            Math.cos(
                                y * 0.019 -
                                worldSeed * 0.0013
                            );

                        return (
                            patch > 1.82 &&
                            Math.sin(
                                (x + y) * 0.013
                            ) > 0.35
                        );
                    }
                };

                generationState.ctx.continentBias =
                    0.9 +
                    (
                        1.5 -
                        generationState.ctx.oceanScale
                    ) * 0.35;

                generationState.ctx.oceanThreshold =
                    0.15 +
                    (
                        1.4 -
                        generationState.ctx.oceanScale
                    ) * 0.08;

                const v2 = currentGenVersion >= 2;
                const areaScale = v2 ? (COLS * ROWS) / (520 * 520) : 1;
                generationState.genVersion = currentGenVersion;
                generationState.plainsDone = false;
                generationState.totalPlains = (v2 && generationState.ctx.mapPreset !== 'dry') ? GEN_V2.plainsBlobs * areaScale : 0;
                generationState.totalForests = (v2 ? GEN_V2.forestBlobs * areaScale : 500) * generationState.ctx.forestScale;
                generationState.totalMountains = (v2 ? GEN_V2.mountainBlobs * areaScale : 300) * generationState.ctx.mountainScale;

                requestAnimationFrame(
                    executeGenerationStep
                );

            } catch (outerErr) {

                alert(
                    `❌ CRASH INSIDE SETUP:\n\n${outerErr.message}`
                );
            }
        }
        // ============================================================
        // ORGANIC WORLD NOISE
        // ============================================================

        function seededNoise2D(x, y, seed = worldSeed) {
            const s =
                Math.sin(
                    x * 127.1 +
                    y * 311.7 +
                    seed * 0.000123
                ) * 43758.5453123;

            return s - Math.floor(s);
        }

        function smoothNoise(x, y) {
            const x0 = Math.floor(x);
            const y0 = Math.floor(y);

            const xf = x - x0;
            const yf = y - y0;

            // Smooth interpolation
            const sx = xf * xf * (3 - 2 * xf);
            const sy = yf * yf * (3 - 2 * yf);

            const n00 = seededNoise2D(x0, y0);
            const n10 = seededNoise2D(x0 + 1, y0);
            const n01 = seededNoise2D(x0, y0 + 1);
            const n11 = seededNoise2D(x0 + 1, y0 + 1);

            const ix0 = n00 + (n10 - n00) * sx;
            const ix1 = n01 + (n11 - n01) * sx;

            return ix0 + (ix1 - ix0) * sy;
        }

        function fbmNoise(x, y, octaves = 4) {
            let value = 0;
            let amplitude = 0.5;
            let frequency = 1;
            let totalAmplitude = 0;

            for (let i = 0; i < octaves; i++) {
                value += smoothNoise(
                    x * frequency,
                    y * frequency
                ) * amplitude;

                totalAmplitude += amplitude;

                frequency *= 2;
                amplitude *= 0.5;
            }

            return value / totalAmplitude;
        }

        function executeGenerationStep() {
            if (!generationState || !generationState.active) return;

            try {
                const c = generationState.ctx;
                if (!c) throw new Error("Generation context (ctx) was not initialized properly.");
                mapTerrainDirty = true;

                switch (generationState.stepIndex) {

                    case 0: { // Organic Terrain

                        const linesPerFrame = Math.max(4, Math.floor(ROWS / 15));

                        const oceanMult = Number(worldConfig.oceanMult) || 1;
                        const forestMult = Number(worldConfig.forestMult) || 1;
                        const mountainMult = Number(worldConfig.mountainMult) || 1;

                        const preset = worldConfig.mapPreset || 'standard';

                        // ---------------------------------------------------------
                        // OCEAN LEVEL
                        // ---------------------------------------------------------

                        let oceanLevel = 0.45;

                        // Higher ocean setting = more ocean.
                        oceanLevel += (oceanMult - 1) * 0.10;

                        if (preset === 'islands') {
                            oceanLevel += 0.08;
                        }

                        if (preset === 'dry') {
                            oceanLevel -= 0.10;
                        }

                        if (preset === 'inland') {
                            oceanLevel -= 0.05;
                        }

                        if (preset === 'riverlands') {
                            oceanLevel -= 0.02;
                        }

                        oceanLevel = Math.max(
                            0.20,
                            Math.min(0.70, oceanLevel)
                        );

                        // ---------------------------------------------------------
                        // GENERATE TERRAIN
                        // ---------------------------------------------------------

                        for (
                            let i = 0;
                            i < linesPerFrame &&
                            generationState.yTracker < ROWS;
                            i++
                        ) {

                            const y = generationState.yTracker;

                            for (let x = 0; x < COLS; x++) {

                                // Normalized coordinates.
                                const nx = x / Math.max(1, COLS - 1);
                                const ny = y / Math.max(1, ROWS - 1);

                                // -------------------------------------------------
                                // LARGE LAND MASS SHAPE
                                // -------------------------------------------------

                                const large = fbmNoise(
                                    nx * 2.5 + worldSeed * 0.00001,
                                    ny * 2.5 + worldSeed * 0.000013,
                                    4
                                );

                                // -------------------------------------------------
                                // MEDIUM TERRAIN
                                // -------------------------------------------------

                                const medium = fbmNoise(
                                    nx * 5.0 + worldSeed * 0.000021,
                                    ny * 5.0 + worldSeed * 0.000017,
                                    4
                                );

                                // -------------------------------------------------
                                // SMALL DETAIL
                                // -------------------------------------------------

                                const detail = fbmNoise(
                                    nx * 11.0 + worldSeed * 0.000031,
                                    ny * 11.0 + worldSeed * 0.000027,
                                    3
                                );

                                // -------------------------------------------------
                                // COMBINE
                                // -------------------------------------------------

                                let elevation =
                                    large * 0.60 +
                                    medium * 0.28 +
                                    detail * 0.12;

                                // Keep it firmly inside 0-1.
                                elevation = Math.max(
                                    0,
                                    Math.min(1, elevation)
                                );

                                // -------------------------------------------------
                                // ISLAND PRESET
                                // -------------------------------------------------

                                if (preset === 'islands') {

                                    const islandDetail = fbmNoise(
                                        nx * 7.0 + worldSeed * 0.000041,
                                        ny * 7.0 + worldSeed * 0.000037,
                                        4
                                    );

                                    elevation =
                                        elevation * 0.70 +
                                        islandDetail * 0.30;
                                }

                                // -------------------------------------------------
                                // MOISTURE
                                // -------------------------------------------------

                                const moisture = fbmNoise(
                                    nx * 6.0 + 100,
                                    ny * 6.0 + 200,
                                    4
                                );

                                // -------------------------------------------------
                                // TEMPERATURE
                                // -------------------------------------------------

                                const temperature = fbmNoise(
                                    nx * 3.5 + 500,
                                    ny * 3.5 + 600,
                                    3
                                );

                                let biome;

                                // -------------------------------------------------
                                // OCEAN
                                // -------------------------------------------------

                                if (
                                    !c.removesOcean &&
                                    elevation < oceanLevel
                                ) {

                                    biome = 'OCEAN';

                                } else {

                                    // -------------------------------------------------
                                    // COAST
                                    // -------------------------------------------------

                                    if (
                                        !c.removesOcean &&
                                        elevation < oceanLevel + 0.045
                                    ) {

                                        biome = 'BEACH';

                                    } else {

                                        // -------------------------------------------------
                                        // MOUNTAIN
                                        // -------------------------------------------------

                                        const mountainThreshold =
                                            0.78 -
                                            ((mountainMult - 1) * 0.08);

                                        if (
                                            elevation > mountainThreshold &&
                                            elevation > oceanLevel + 0.15
                                        ) {

                                            if (temperature < 0.30) {
                                                biome = 'SNOW';
                                            } else {
                                                biome = 'MOUNTAIN';
                                            }

                                        } else {

                                            // -------------------------------------------------
                                            // DESERT
                                            // -------------------------------------------------

                                            if (
                                                preset === 'dry' ||
                                                (
                                                    moisture < 0.28 &&
                                                    temperature > 0.50
                                                )
                                            ) {

                                                biome = 'DESERT';

                                            } else {

                                                // -------------------------------------------------
                                                // FOREST
                                                // -------------------------------------------------

                                                const forestThreshold =
                                                    0.68 -
                                                    ((forestMult - 1) * 0.10);

                                                if (
                                                    moisture > forestThreshold &&
                                                    elevation > oceanLevel + 0.05
                                                ) {

                                                    biome = 'FOREST';

                                                } else {

                                                    biome = 'PLAINS';
                                                }
                                            }
                                        }
                                    }
                                }

                                // v2: land that isn't mountain/snow/beach starts as DESERT. Plains and forest are painted on afterwards.
                                if (generationState.genVersion >= 2 && (biome === 'PLAINS' || biome === 'FOREST')) biome = 'DESERT';

                                // Preset cleanup.
                                if (
                                    preset === 'dry' &&
                                    biome === 'BEACH'
                                ) {
                                    biome = 'DESERT';
                                }

                                if (
                                    preset === 'inland' &&
                                    biome === 'BEACH'
                                ) {
                                    biome = 'PLAINS';
                                }

                                if (x === Math.floor(COLS / 2) && y === Math.floor(ROWS / 2)) {
                                    console.log(
                                        "TERRAIN TEST",
                                        {
                                            elevation,
                                            oceanLevel,
                                            moisture,
                                            temperature,
                                            biome
                                        }
                                    );
                                }

                                worldGrid[y][x] = biome;
                            }

                            generationState.yTracker++;
                        }

                        if (generationState.yTracker >= ROWS) {
                            generationState.stepIndex = 1;
                        }

                        break;
                    }

                    case 1: // Rivers
                        const riverCount = c.mapPreset === 'dry' ? 0 : Math.max(2, Math.min(6, Math.round((COLS + ROWS) / 220)));
                        for (let i = 0; i < riverCount; i++) {
                            let x = Math.floor(seededRandom() * COLS);
                            let y = Math.floor(seededRandom() * ROWS);
                            const targetX = Math.floor(COLS * (0.3 + seededRandom() * 0.4));
                            const targetY = Math.floor(ROWS * (0.3 + seededRandom() * 0.4));

                            for (let step = 0; step < 420; step++) {
                                const dx = targetX - x;
                                const dy = targetY - y;
                                const dist = Math.max(1, Math.hypot(dx, dy));
                                x += Math.max(-2, Math.min(2, Math.round((dx / dist) * (1 + seededRandom() * 2.5))));
                                y += Math.max(-2, Math.min(2, Math.round((dy / dist) * (1 + seededRandom() * 2.5))));
                                x = Math.max(0, Math.min(COLS - 1, x));
                                y = Math.max(0, Math.min(ROWS - 1, y));

                                for (let yy = Math.max(0, y - 1); yy <= Math.min(ROWS - 1, y + 1); yy++) {
                                    for (let xx = Math.max(0, x - 1); xx <= Math.min(COLS - 1, x + 1); xx++) {
                                        if (worldGrid[yy] && worldGrid[yy][xx] !== 'OCEAN' && worldGrid[yy][xx] !== 'LAKE') worldGrid[yy][xx] = 'RIVER';
                                    }
                                }
                            }
                        }
                        generationState.stepIndex = 2;
                        break;

                    case 2: // Lakes
                        const clusterLakes = c.mapPreset === 'dry' ? 0 : 10;
                        for (let i = 0; i < clusterLakes; i++) {
                            const cx = Math.floor(seededRandom() * COLS);
                            const cy = Math.floor(seededRandom() * ROWS);
                            const radius = 6 + Math.floor(seededRandom() * 14);
                            const rSq = radius * radius;
                            for (let y = Math.max(0, cy - radius); y < Math.min(ROWS, cy + radius); y++) {
                                for (let x = Math.max(0, cx - radius); x < Math.min(COLS, cx + radius); x++) {
                                    if (((x - cx) ** 2 + (y - cy) ** 2) < rSq && worldGrid[y] && worldGrid[y][x] !== 'OCEAN' && worldGrid[y][x] !== 'SNOW') worldGrid[y][x] = 'LAKE';
                                }
                            }
                        }
                        generationState.stepIndex = 3;
                        break;

                    case 3: // Plains (v2 only), then forests
                        // v2: paint plains once, before the forests, so forests and mountains overwrite them.
                        if (generationState.genVersion >= 2 && !generationState.plainsDone) {
                            generationState.plainsDone = true;
                            for (let i = 0; i < generationState.totalPlains; i++) {
                                const cx = Math.floor(seededRandom() * COLS);
                                const cy = Math.floor(seededRandom() * ROWS);
                                const radius = GEN_V2.plainsRadius[0] + Math.floor(seededRandom() * GEN_V2.plainsRadius[1]);
                                const rSq = radius * radius;
                                for (let y = Math.max(0, cy - radius); y < Math.min(ROWS, cy + radius); y++) {
                                    for (let x = Math.max(0, cx - radius); x < Math.min(COLS, cx + radius); x++) {
                                        if (worldGrid[y] && ((x - cx) ** 2 + (y - cy) ** 2) < rSq && !c.LIQUIDS.has(worldGrid[y][x]) &&
                                            worldGrid[y][x] !== 'BEACH' && worldGrid[y][x] !== 'MOUNTAIN' && worldGrid[y][x] !== 'SNOW') {
                                            worldGrid[y][x] = 'PLAINS';
                                        }
                                    }
                                }
                            }
                        }

                        let forestBatches = Math.max(10, Math.floor(generationState.totalForests / 10));
                        for (let i = 0; i < forestBatches && generationState.forestIndex < generationState.totalForests; i++) {
                            const cx = Math.floor(seededRandom() * COLS);
                            const cy = Math.floor(seededRandom() * ROWS);
                            const radius = 14 + Math.floor(seededRandom() * 18);
                            const rSq = radius * radius;
                            for (let y = Math.max(0, cy - radius); y < Math.min(ROWS, cy + radius); y++) {
                                for (let x = Math.max(0, cx - radius); x < Math.min(COLS, cx + radius); x++) {
                                    if (worldGrid[y] && ((x - cx) ** 2 + (y - cy) ** 2) < rSq && !c.LIQUIDS.has(worldGrid[y][x]) && worldGrid[y][x] !== 'BEACH' && worldGrid[y][x] !== 'MOUNTAIN') {
                                        worldGrid[y][x] = 'FOREST';
                                    }
                                }
                            }
                            generationState.forestIndex++;
                        }
                        if (generationState.forestIndex >= generationState.totalForests) generationState.stepIndex = 4;
                        break;
                    case 4: // Mountains
                        let mountainBatches = Math.max(10, Math.floor(generationState.totalMountains / 10));
                        for (let i = 0; i < mountainBatches && generationState.mountainIndex < generationState.totalMountains; i++) {
                            const cx = Math.floor(seededRandom() * COLS);
                            const cy = Math.floor(seededRandom() * ROWS);
                            const radius = 10 + Math.floor(seededRandom() * 14);
                            const rSq = radius * radius;
                            for (let y = Math.max(0, cy - radius); y < Math.min(ROWS, cy + radius); y++) {
                                for (let x = Math.max(0, cx - radius); x < Math.min(COLS, cx + radius); x++) {
                                    if (worldGrid[y] && ((x - cx) ** 2 + (y - cy) ** 2) < rSq && !c.LIQUIDS.has(worldGrid[y][x]) && worldGrid[y][x] !== 'BEACH') {
                                        worldGrid[y][x] = 'MOUNTAIN';
                                    }
                                }
                            }
                            generationState.mountainIndex++;
                        }
                        if (generationState.mountainIndex >= generationState.totalMountains) {
                            generationState.stepIndex = 5;
                            generationState.yTracker = 0;
                        }
                        break;

                    case 5: // Shallows / Shoreline / Entity Spawns
                        let cleanLinesPerFrame = Math.max(4, Math.floor(ROWS / 10));
                        for (let i = 0; i < cleanLinesPerFrame && generationState.yTracker < ROWS; i++) {
                            let y = generationState.yTracker;
                            for (let x = 0; x < COLS; x++) {
                                let biome = worldGrid[y][x];

                                if (!c.LIQUIDS.has(biome)) {
                                    const west = x > 0 ? worldGrid[y][x - 1] : null;
                                    const east = x < COLS - 1 ? worldGrid[y][x + 1] : null;
                                    const north = y > 0 ? worldGrid[y - 1][x] : null;
                                    const south = y < ROWS - 1 ? worldGrid[y + 1][x] : null;
                                    if (c.LIQUIDS.has(west) || c.LIQUIDS.has(east) || c.LIQUIDS.has(north) || c.LIQUIDS.has(south)) {
                                        worldGrid[y][x] = c.isDryOrInland ? 'DESERT' : 'BEACH';
                                        biome = worldGrid[y][x];
                                    }
                                } else if (biome === 'OCEAN') {
                                    const west = x > 0 ? worldGrid[y][x - 1] : null;
                                    const east = x < COLS - 1 ? worldGrid[y][x + 1] : null;
                                    const north = y > 0 ? worldGrid[y - 1][x] : null;
                                    const south = y < ROWS - 1 ? worldGrid[y + 1][x] : null;
                                    if (west === 'BEACH' || east === 'BEACH' || north === 'BEACH' || south === 'BEACH') {
                                        worldGrid[y][x] = 'SHALLOW_WATER';
                                        continue;
                                    }
                                    continue;
                                } else {
                                    continue;
                                }
                                if (generationState.fromSave) continue;   // shoreline is done; don't spawn entities
                                if (c.isBarrenZone(x, y)) continue;
                                const roll = seededRandom();
                                const cellOffset = y * COLS + x;
                                if (roll < 0.12 * worldConfig.resMult) {
                                    if (biome === 'FOREST' || biome === 'BEACH' || biome === 'SNOW') {
                                        const treeType = biome === 'BEACH' ? 'palm' : biome === 'SNOW' ? 'snow' : 'forest';
                                        resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'wood', icon: biome === 'BEACH' ? '🌴' : biome === 'SNOW' ? '🌲' : '🌳', hp: 5, maxHp: 5, biome: treeType });
                                        c.occupancy[cellOffset] = 1;
                                    } else if (biome === 'MOUNTAIN') {
                                        const isIron = seededRandom() < 0.24;
                                        resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: isIron ? 'iron' : 'big_rock', icon: isIron ? '⛓️' : '🪨', hp: isIron ? 8 : 10, maxHp: isIron ? 8 : 10 });
                                        c.occupancy[cellOffset] = 1;
                                    }
                                }
                                if (!c.occupancy[cellOffset] && roll < 0.08 * worldConfig.resMult) {
                                    if (biome === 'BEACH') {
                                        if (seededRandom() < 0.35) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'twigs', icon: '🥢', pickup: true });
                                        if (seededRandom() < 0.1 * worldConfig.foodMult) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'berries', icon: '🍒', pickup: true });
                                    } else if (biome === 'PLAINS' || biome === 'DESERT') {
                                        if (seededRandom() < 0.18 * worldConfig.resMult) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'flint', icon: '🔷', pickup: true });
                                        if (seededRandom() < 0.035 * worldConfig.foodMult) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'carrots', icon: '🥕', pickup: true });
                                        if (seededRandom() < 0.01 * worldConfig.wildlifeMult) mobs.push({ x: x * cellSize, y: y * cellSize, emoji: '🐘', tx: x * cellSize, ty: y * cellSize, hp: 100, maxHp: 100 });
                                    } else if (biome === 'FOREST' || biome === 'SNOW') {
                                        if (seededRandom() < 0.22) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'twigs', icon: '🥢', pickup: true });
                                        if (seededRandom() < 0.18) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'acorn', icon: '🌰', pickup: true });
                                        if (seededRandom() < 0.12 * worldConfig.foodMult) resourceNodes.push({ x: x * cellSize, y: y * cellSize, type: 'berries', icon: '🍒', pickup: true });
                                    }
                                }
                            }
                            generationState.yTracker++;
                        }
                        if (generationState.yTracker >= ROWS) generationState.stepIndex = 6;
                        break;
                    case 6: // Ruins
                        if (generationState.fromSave) { generationState.stepIndex = 7; break; }
                        for (let i = 0; i < 12; i++) {
                            const x = Math.floor(seededRandom() * (COLS - 8)) + 4;
                            const y = Math.floor(seededRandom() * (ROWS - 8)) + 4;
                            if (!worldGrid[y] || !['PLAINS', 'DESERT', 'FOREST'].includes(worldGrid[y][x]) || c.isBarrenZone(x, y)) continue;
                            const walls = [[-1, -1], [0, -1], [1, -1], [-1, 1], [-1, 0]];
                            walls.forEach(([ox, oy]) => buildings.push({ x: (x + ox) * cellSize, y: (y + oy) * cellSize, type: 'wall', hp: 500, maxHp: 500 }));
                            if (seededRandom() < 0.7) {
                                const inventory = Array.from({ length: 10 }, () => ({ type: null, count: 0 }));
                                const loot = [['wood', 40], ['stone', 30], ['flint', 15], ['twigs', 30], ['berries', 10]];
                                loot.slice(0, 2 + Math.floor(seededRandom() * 3)).forEach(([type, count], index) => { inventory[index] = { type, count }; });
                                buildings.push({ x: x * cellSize, y: y * cellSize, type: 'chest', hp: 400, maxHp: 400, inventory });
                            }
                        }
                        generationState.stepIndex = 7;
                        break;
                    case 7: // Done
                        if (generationState.fromSave) { generationState.active = false; finishLoadFromSave(); break; }
                        const spawn = findNearestLandSpawn();
                        player.x = spawn.x;
                        player.y = spawn.y;
                        player.inBoat = false;
                        player.boatId = null;
                        placementMouse = { x: player.x, y: player.y };
                        generationState.active = false;
                        currentState = 'GAME';
                        startGameUI();
                        break;
                } // This closes the switch statement

                if (generationState.active) {
                    requestAnimationFrame(executeGenerationStep);
                }
            } catch (err) {
                generationState.active = false;
                alert(`🚨 MAP GENERATOR CRASHED!\n\nStep Index: ${generationState?.stepIndex}\nRow Tracker: ${generationState?.yTracker}\nError Details: ${err.message}`);
            }
        }




        function seedBiome(cx, cy, type, size) {
            const sX = Math.max(0, Math.floor(cx - size)), eX = Math.min(COLS, Math.ceil(cx + size));
            const sY = Math.max(0, Math.floor(cy - size)), eY = Math.min(ROWS, Math.ceil(cy + size));
            for (let y = sY; y < eY; y++) for (let x = sX; x < eX; x++) if (worldGrid[y][x] !== 'OCEAN' && Math.sqrt((x - cx) ** 2 + (y - cy) ** 2) < size * seededRandom() * 2) worldGrid[y][x] = type;
        }

        let _discoveryThrottleCounter = 0;
        function updateDiscovery() {
            if ((frameCount % 3) !== 0) return;
            // Throttle discovery updates in creative mode to reduce CPU when many tiles
            if (worldConfig.creative) { if ((_discoveryThrottleCounter++ % 6) !== 0) return; }
            const px = Math.floor(player.x / 40), py = Math.floor(player.y / 40);
            const newly = [];
            for (let y = py - 8; y <= py + 8; y++) for (let x = px - 8; x <= px + 8; x++) if (x >= 0 && x < COLS && y >= 0 && y < ROWS && Math.sqrt((x - px) ** 2 + (y - py) ** 2) <= 8 && !discoveredGrid[y * COLS + x]) { discoveredGrid[y * COLS + x] = 1; newly.push(y * COLS + x); }
            if (newly.length) mapTerrainDirty = true;
            // Send discovered updates to server in batches
            if (gameSocket && gameSocket.readyState === WebSocket.OPEN && newly.length) {
                gameSocket.send(JSON.stringify({ type: 'discovered:update', roomId: onlineRoom, playerId: onlinePlayerId, tiles: newly }));
            }
        }

        function handleHarvest(node, idx) {
            const activeItem = getActiveItem();
            const hasAxe = activeItem.type === 'axe';
            const hasPick = activeItem.type === 'pickaxe';
            const hasShovel = activeItem.type === 'shovel';

            if (node.pickup) {
                addToInv(node.type, 1);
                resourceNodes.splice(idx, 1);
                return;
            }

            if (node.type === 'wood' || node.type === 'tree') {
                if (hasAxe) {
                    node.hp--; useToolDurability();
                    if (node.hp <= 0) {
                        addToInv('wood', 5);
                        addToInv('twigs', 2);
                        if (Math.random() < 0.45) addToInv('acorn', 1);
                        node.type = 'stump'; node.icon = '🪵'; node.hp = 3; node.maxHp = 3;
                    }
                } else {
                    shakeTreeLocal(node);
                }
                return;
            }

            if (node.type === 'big_rock') {
                if (hasPick) {
                    node.hp--; useToolDurability();
                    if (node.hp <= 0) {
                        addToInv('stone', 2);
                        addToInv('flint', 1 + (Math.random() < 0.5 ? 1 : 0));
                        resourceNodes.splice(idx, 1);
                    }
                } else if (frameCount % 60 === 0) {
                    displayChat({ name: 'SYSTEM', text: 'Select a Pickaxe (⛏️) on the hotbar.', color: '#ffa500' });
                }
                return;
            }

            if (node.type === 'flint_node' || node.type === 'rock') {
                if (hasPick) {
                    node.hp--; useToolDurability();
                    if (node.hp <= 0) {
                        addToInv('flint', 1);
                        resourceNodes.splice(idx, 1);
                    }
                } else if (frameCount % 60 === 0) {
                    displayChat({ name: 'SYSTEM', text: 'Select a Pickaxe (⛏️) on the hotbar.', color: '#ffa500' });
                }
                return;
            }

            if (node.type === 'stone' || node.type === 'iron') {
                if (hasPick) {
                    node.hp--; useToolDurability();
                    if (node.hp <= 0) {
                        addToInv(node.type, 5);
                        resourceNodes.splice(idx, 1);
                    }
                } else if (frameCount % 60 === 0) {
                    displayChat({ name: 'SYSTEM', text: 'Select a Pickaxe (⛏️) on the hotbar.', color: '#ffa500' });
                }
                return;
            }

            if (node.type === 'stump') {
                if (hasShovel) {
                    node.hp--; useToolDurability();
                    if (node.hp <= 0) {
                        addToInv('wood', 2);
                        resourceNodes.splice(idx, 1);
                    }
                } else if (frameCount % 60 === 0) {
                    displayChat({ name: 'SYSTEM', text: 'Select a Shovel (🧹) on the hotbar.', color: '#ffa500' });
                }
            }
        }

        function getBiomeAtWorldPos(x, y) {
            const tileX = Math.floor((x + 20) / cellSize);
            const tileY = Math.floor((y + 20) / cellSize);
            if (tileX < 0 || tileY < 0 || tileX >= COLS || tileY >= ROWS) return 'OCEAN';
            return worldGrid[tileY]?.[tileX] || 'OCEAN';
        }

        function wrapWorldCoordinate(value, limit) {
            return value < 0 ? limit + value : value >= limit ? value - limit : value;
        }

        function isLocationBlocked(x, y) {
            if (creativeNoclip) return false;
            const tileX = Math.floor((x + 13) / cellSize);
            const tileY = Math.floor((y + 13) / cellSize);
            if (tileX < 0 || tileY < 0 || tileX >= COLS || tileY >= ROWS) return true;
            const biome = worldGrid[tileY]?.[tileX];
            const waterBlocked = biome && BIOMES[biome] && BIOMES[biome].passable === false && !player.inBoat;
            const blockedByWall = buildings.some(b => b.type === 'wall' && Math.abs((x + 13) - (b.x + 20)) < 22 && Math.abs((y + 13) - (b.y + 20)) < 22);
            return waterBlocked || blockedByWall;
        }

        function canPlaceStructureAt(x, y, type) {
            const blockedByWall = buildings.some(b => b.type === 'wall' && Math.abs(b.x - x) < 40 && Math.abs(b.y - y) < 40);
            const blockedByBuilding = buildings.some(b => b.type !== 'wall' && Math.abs(b.x - x) < 40 && Math.abs(b.y - y) < 40 && b.type !== 'acorn');
            const blockedByNode = resourceNodes.some(n => Math.abs(n.x - x) < 40 && Math.abs(n.y - y) < 40 && n.type !== 'sapling');
            const tooCloseToPlayer = Math.abs(player.x - x) < 30 && Math.abs(player.y - y) < 30;
            const biome = getBiomeAtWorldPos(x, y);
            const waterTile = BIOMES[biome] && BIOMES[biome].passable === false;
            const overWaterOnly = type === 'boat';
            if (type === 'wall') return !(blockedByWall || blockedByBuilding || blockedByNode || tooCloseToPlayer || waterTile);
            if (overWaterOnly) return !(blockedByBuilding || blockedByNode || tooCloseToPlayer || !waterTile || buildings.some(b => b.type === 'boat' && Math.abs(b.x - x) < 40 && Math.abs(b.y - y) < 40));
            return !(blockedByBuilding || blockedByNode || tooCloseToPlayer || waterTile);
        }

        function tryPlaceStructure() {
            const target = placementMouse;
            const type = buildMode;

            if (!type || type === 'none') return;

            // -----------------------------------------
            // CHECK LOCATION
            // -----------------------------------------
            if (!canPlaceStructureAt(target.x, target.y, type)) {
                displayChat({
                    name: 'SYSTEM',
                    text: type === 'boat'
                        ? 'Boats must be placed over deep water.'
                        : 'You cannot place there.',
                    color: '#ffa500'
                });

                // No resources have been spent yet,
                // so cancelling is automatically a full refund.
                cancelPlacement();
                return;
            }

            // -----------------------------------------
            // ACORN
            // -----------------------------------------
            if (type === 'acorn') {
                if (isOnlineActive()) { sendWorldAction('place', { type: 'acorn', x: target.x, y: target.y }); cancelPlacement(); return; }
                const slot =
                    player.inventory.find(
                        s => s && s.type === 'acorn'
                    );

                if (!slot || slot.count <= 0) {
                    displayChat({
                        name: 'SYSTEM',
                        text: 'No acorns left to plant.',
                        color: '#ffa500'
                    });

                    cancelPlacement();
                    return;
                }

                if (!worldConfig.creative) {
                    slot.count -= 1;

                    if (slot.count <= 0) {
                        slot.type = null;
                        slot.count = 0;
                    }
                }

                resourceNodes.push({
                    x: target.x,
                    y: target.y,
                    type: 'sapling',
                    icon: '🌱',
                    hp: 1,
                    maxHp: 1,
                    plantedDay: dayCount + 1,
                    pickup: false
                });

                displayChat({
                    name: 'SYSTEM',
                    text: 'Acorn planted. It will sprout in 1 day.',
                    color: '#2ecc71'
                });

                renderInventory();

                // Acorns are single-use, so leave placement mode.
                cancelPlacement();

                return;
            }

            // -----------------------------------------
            // STRUCTURE
            // -----------------------------------------
            const recipe = BUILDINGS[type];

            if (!recipe) {
                console.warn(
                    'Unknown building type:',
                    type
                );

                cancelPlacement();
                return;
            }

            // Check resources BEFORE placing.
            if (!worldConfig.creative && !hasRes(recipe)) {
                displayChat({
                    name: 'SYSTEM',
                    text: `${recipe.name}: need materials.`,
                    color: '#f00'
                });

                // Stay in placement mode so the player can
                // potentially gather materials and try again.
                return;
            }

            // -----------------------------------------
            // ONLINE
            // -----------------------------------------
            if (
                gameSocket &&
                gameSocket.readyState === WebSocket.OPEN
            ) {
                gameSocket.send(JSON.stringify({
                    type: 'world:action',
                    playerId: onlinePlayerId,
                    action: {
                        type: 'place',
                        payload: {
                            type,
                            x: target.x,
                            y: target.y
                        }
                    }
                }));

                setBlueprintFeedback(
                    `${recipe.name} requested.`
                );

                displayChat({
                    name: 'SYSTEM',
                    text:
                        `Requesting placement of ${recipe.name}...`,
                    color: '#888'
                });

                /*
                 * IMPORTANT:
                 *
                 * Do NOT pay resources here.
                 *
                 * The server should deduct them only after
                 * successfully accepting the placement.
                 *
                 * The server response should ultimately tell
                 * the client whether placement succeeded.
                 */

            } else {

                // -----------------------------------------
                // OFFLINE / SOLO
                // -----------------------------------------
                if (!worldConfig.creative) {
                    payRes(recipe);
                }

                const building = {
                    x: target.x,
                    y: target.y,
                    type,
                    hp: recipe.hp || 100,
                    maxHp: recipe.hp || 100,
                    life: recipe.life || Infinity,

                    inventory:
                        type === 'chest'
                            ? Array.from(
                                { length: 10 },
                                () => ({
                                    type: null,
                                    count: 0
                                })
                            )
                            : undefined
                };

                buildings.push(building);

                setBlueprintFeedback(
                    `${recipe.name} placed (offline).`
                );

                displayChat({
                    name: 'SYSTEM',
                    text:
                        `${recipe.name} placed.`,
                    color: '#2ecc71'
                });
            }

            // -----------------------------------------
            // KEEP PLACEMENT MODE ACTIVE
            // -----------------------------------------
            //
            // DO NOT call cancelPlacement() here.
            //
            // This is what allows:
            //
            // WALL → click → WALL → click → WALL → click
            //
            // without reopening the build menu.
            //
            // The player exits with X / ESC / right-click.
        }

        function handleInput(e) {
            if (currentState !== 'GAME' || player.isDowned) return;
            const rect = canvas.getBoundingClientRect();
            const mx = (e.clientX - rect.left) / globalScale + camera.x, my = (e.clientY - rect.top) / globalScale + camera.y;
            placementMouse = { x: Math.floor(mx / 40) * 40, y: Math.floor(my / 40) * 40 };
            if (e.shiftKey && creativeAvailable()) { creativeTeleportToTile(mx / cellSize, my / cellSize); return; }

            const activeItem = getActiveItem();
            if (!isPlacing && activeItem && activeItem.type === 'acorn') {
                buildMode = 'acorn';
                isPlacing = true;
                document.getElementById('placement-label').innerText = 'PLACING ACORN';
                document.getElementById('placement-controls').style.display = 'flex';
                return;
            }

            if (isPlacing && buildMode !== 'none') {
                tryPlaceStructure();
                return;
            }

            const gx = Math.floor(mx / 40), gy = Math.floor(my / 40);
            const bIdx = buildings.findIndex(b => Math.floor(b.x / 40) === gx && Math.floor(b.y / 40) === gy);
            const nodeIdx = resourceNodes.findIndex(n => Math.abs(n.x + 20 - mx) < 20 && Math.abs(n.y + 20 - my) < 20);

            if (bIdx !== -1) {
                const bld = buildings[bIdx];
                const dist = Math.hypot(player.x - bld.x, player.y - bld.y);
                if (bld.type === 'boat') {
                    if (dist < 60) {
                        if (gameSocket && gameSocket.readyState === WebSocket.OPEN) {
                            gameSocket.send(JSON.stringify({ type: 'world:action', playerId: onlinePlayerId, action: { type: 'board', payload: { x: bld.x, y: bld.y } } }));
                        } else {
                            player.inBoat = true; player.boatId = bld.x + ',' + bld.y; displayChat({ name: 'SYSTEM', text: 'You board the boat.', color: '#2ecc71' });
                        }
                    }
                    return;
                }
                if (bld.type === 'chest') {
                    if (dist < 80) { openChest(bld); }
                    else displayChat({ name: 'SYSTEM', text: 'You are too far away to access the chest.', color: '#ffa500' });
                    return;
                }
            }

            // Click something: walk up to it (pathfinding), then act on it.
            const mobIdx = mobs.findIndex(m => Math.sqrt((m.x + 20 - mx) ** 2 + (m.y + 20 - my) ** 2) < 40);
            if (mobIdx !== -1) { startMobTask(mobs[mobIdx]); return; }
            if (nodeIdx !== -1) { startNodeTask(resourceNodes[nodeIdx]); return; }
            if (bIdx !== -1 && buildMode === 'none' && ['research', 'cooking'].includes(buildings[bIdx].type)) toggleBuildMenu();
        }

        function toggleBuildMenu() {
            if (player.isDowned) return;
            const overlay = document.getElementById('build-menu-overlay');
            if (overlay.style.display === 'flex') { closeBuildMenu(); return; }

            stopMovement();
            const nearLab = buildings.some(b => b.type === 'research' && Math.sqrt((player.x - b.x) ** 2 + (player.y - b.y) ** 2) < 180);
            document.getElementById('science-warning').style.display = nearLab ? 'none' : 'block';
            renderBlueprints(nearLab);
            overlay.style.display = 'flex';
        }

        function blueprintType(key) {
            if (['axe', 'pickaxe', 'torch', 'shovel', 'acorn'].includes(key)) return 'TOOLS';
            if (['campfire', 'wall', 'boat', 'door', 'chest'].includes(key)) return 'STRUCTURES';
            if (['research', 'extractor', 'cooking'].includes(key)) return 'STATIONS';
            return 'TOOLS';
        }

        function recipeCosts(data) {
            const costs = [];
            if (data.twigs) costs.push(`${data.twigs} TWIGS`);
            if (data.flint) costs.push(`${data.flint} FLINT`);
            if (data.wood) costs.push(`${data.wood} WOOD`);
            if (data.stone) costs.push(`${data.stone} STONE`);
            if (data.iron) costs.push(`${data.iron} IRON`);
            return costs.join('  •  ') || 'NO COST';
        }

        function createRecipeCard(name, icon, type, cost, available, action, note) {
            const card = document.createElement('div');
            card.className = `build-card ${available ? '' : 'locked'}`;
            card.innerHTML = `<span class="recipe-icon">${icon}</span><div><div class="recipe-name">${name}</div><div class="recipe-type">${type}</div></div><div class="recipe-cost">${cost}</div><div class="recipe-action">${note}</div>`;
