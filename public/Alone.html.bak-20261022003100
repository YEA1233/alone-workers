    <style>
        :root {
            --bg-color: #050505;
            --ui-bg: rgba(10, 10, 10, 0.98);
            --accent: #ff4444;
            --hunger: #ffa500;
            --text: #eeeeee;
            --gold: #ffcc00;
            --success: #2ecc71;
            --border: #333;
            --wood: #a67c52;
            --stone: #888888;
            --iron: #d3d3d3;
            --day: #87ceeb;
            --night: #111133;
        }

        body,
        html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: none;
            color: var(--text);
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        canvas {
            display: block;
            background-color: #000;
            cursor: default;
        }

        .overlay {
            position: absolute;
            color: var(--text);
            user-select: none;
        }

        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 3000;
            text-align: center;
            color: var(--text);
        }

        h1 {
            font-size: 5rem;
            color: var(--accent);
            margin: 0;
            text-shadow: 0 0 20px rgba(255, 68, 68, 0.5);
            letter-spacing: 15px;
            font-weight: 900;
        }

        h2 {
            color: white;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .menu-btn {
            background: #111;
            border: 1px solid #444;
            color: white;
            padding: 12px 30px;
            margin: 10px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.2s;
            min-width: 220px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .menu-btn:hover {
            border-color: var(--hunger);
            color: var(--hunger);
            background: #1a1a00;
        }

        .menu-btn.primary {
            background: #221a00;
            border-color: var(--hunger);
            color: var(--hunger);
        }

        /* HUD & Stats */
        #hud {
            top: 88px;
            left: 20px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            pointer-events: none;
            z-index: 100;
        }

        .stat-box {
            background: var(--ui-bg);
            padding: 8px 15px;
            border: 1px solid #222;
            font-weight: bold;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            min-width: 180px;
            color: white;
        }

        .stat-box.warning {
            border-color: var(--hunger);
            color: var(--hunger);
            animation: warning-pulse 1.4s ease-in-out infinite;
        }

        .stat-box.critical {
            border-color: var(--accent);
            color: var(--accent);
            animation: warning-pulse 0.65s ease-in-out infinite;
        }

        @keyframes warning-pulse {
            50% {
                background: rgba(90, 20, 0, 0.9);
            }
        }

        .hp-border {
            border-left: 5px solid var(--accent);
        }

        .hunger-border {
            border-left: 5px solid var(--hunger);
        }

        /* Hotbar */
        #inventory-container {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 0, 0, 0.85);
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #333;
            z-index: 500;
        }

        #inventory-bar {
            display: flex;
            gap: 6px;
        }

        .inv-slot {
            width: 50px;
            height: 50px;
            background: #111;
            border: 1px solid #444;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            border-radius: 6px;
            color: white;
            font-size: 1.4rem;
            cursor: pointer;
        }

        .inv-slot:hover {
            border-color: #666;
        }

        .inv-slot.selected {
            border: 2px solid var(--gold);
            background: #1a1a00;
            transform: translateY(-4px);
        }

        .inv-slot .slot-number {
            position: absolute;
            top: 2px;
            left: 5px;
            font-size: 0.55rem;
            color: #888;
        }

        .inv-slot .count {
            position: absolute;
            bottom: 2px;
            right: 5px;
            font-size: 0.7rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 1px 1px 2px black;
        }

        .inv-slot .dur-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: var(--success);
            width: 0%;
        }

        /* World Settings */
        .settings-wrap {
            background: #111;
            padding: 20px;
            border: 1px solid #333;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            max-height: 62vh;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #ccc;
            font-size: 0.8rem;
        }

        .setting-item input[type="range"] {
            width: 150px;
            accent-color: var(--hunger);
        }

        .creative-toggle {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            color: var(--gold);
            font-size: 0.8rem;
            font-weight: bold;
            border-top: 1px solid #333;
            padding-top: 12px;
        }

        .creative-toggle input {
            accent-color: var(--gold);
        }

        .creative-toggle small {
            width: 100%;
            color: #888;
            font-size: 0.6rem;
            font-weight: normal;
            margin-left: 22px;
        }

        /* World Clock */
        #clock-container {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--ui-bg);
            border: 1px solid #333;
            padding: 10px 30px;
            text-align: center;
            z-index: 100;
            border-radius: 0 0 15px 15px;
        }

        #day-count {
            font-size: 0.7rem;
            font-weight: 900;
            color: var(--gold);
        }

        #phase-label {
            font-size: 0.5rem;
            text-transform: uppercase;
            color: #888;
            letter-spacing: 2px;
        }

        #phase-timer {
            font-size: 1.2rem;
            font-weight: 900;
            color: white;
        }

        /* Warnings */
        #darkness-warning {
            display: none;
        }

        #darkness-warning {
            display: none;
        }

        /* UI Overlays */
        #top-controls {
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
            z-index: 100;
        }

        #minimap-container {
            width: 210px;
            height: 140px;
            background: #000;
            border: 1px solid #333;
        }

        #utility-bar {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 500;
        }

        #utility-bar {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 500;
        }

        .util-item {
            background: #111;
            border: 1px solid #333;
            color: white;
            padding: 12px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 140px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        #placement-controls {
            position: absolute;
            top: 20px;
            left: 190px;
            z-index: 700;
            display: none;
            align-items: center;
            gap: 8px;
            background: rgba(0, 0, 0, 0.85);
            padding: 8px;
            border: 1px solid var(--gold);
        }

        #placement-label {
            color: var(--gold);
            font-size: 0.7rem;
            font-weight: bold;
        }

        #placement-cancel,
        .map-control {
            min-width: 0;
            width: 34px;
            height: 30px;
            padding: 0;
            margin: 0;
        }

        #build-menu-overlay {
            padding: 24px;
            box-sizing: border-box;
        }

        #build-menu-overlay h2 {
            margin: 0 0 4px;
        }

        #blueprint-subtitle {
            margin: 0 0 14px;
            color: #888;
            font-size: 0.7rem;
        }

        #blueprint-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            width: min(760px, 94vw);
            margin-bottom: 10px;
        }

        .blueprint-tab {
            flex: 1 1 100px;
            border: 1px solid #333;
            background: #111;
            color: #aaa;
            padding: 8px 10px;
            cursor: pointer;
            font-size: 0.65rem;
            text-transform: uppercase;
        }

        .blueprint-tab.active {
            border-color: var(--gold);
            color: var(--gold);
            background: #1a1605;
        }

        .blueprint-tab:hover {
            border-color: #777;
            color: white;
        }

        #blueprint-summary {
            width: min(760px, 94vw);
            color: #777;
            font-size: 0.65rem;
            text-align: left;
            margin-bottom: 6px;
        }

        #blueprint-feedback {
            width: min(760px, 94vw);
            min-height: 1.1em;
            color: var(--hunger);
            font-size: 0.65rem;
            text-align: left;
            margin-bottom: 6px;
        }

        .build-grid {
            width: min(760px, 94vw);
            max-height: min(55vh, 520px);
            overflow-y: auto;
            padding: 0 4px 4px 0;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .build-card {
            display: grid;
            grid-template-columns: 42px minmax(110px, 1fr) minmax(130px, 0.8fr) auto;
            align-items: center;
            gap: 10px;
            min-height: 58px;
            padding: 8px 10px;
            background: #111;
            border: 1px solid #333;
            border-radius: 4px;
            cursor: pointer;
            text-align: left;
            transition: border-color 0.2s, background 0.2s;
        }

        .build-card:hover {
            border-color: var(--hunger);
            background: #1a180d;
        }

        .build-card.locked {
            opacity: 0.45;
            cursor: not-allowed;
            filter: grayscale(0.7);
        }

        .build-card .recipe-icon {
            grid-row: span 2;
            font-size: 1.7rem;
            text-align: center;
        }

        .build-card .recipe-name {
            font-weight: 900;
            color: white;
            font-size: 0.8rem;
        }

        .build-card .recipe-type {
            color: #777;
            font-size: 0.58rem;
            text-transform: uppercase;
        }

        .build-card .recipe-cost {
            color: #bbb;
            font-size: 0.65rem;
        }

        .build-card .recipe-action {
            color: var(--success);
            font-size: 0.6rem;
            font-weight: bold;
            text-align: right;
            text-transform: uppercase;
        }

        .build-card.locked .recipe-action {
            color: var(--gold);
        }

        @media (max-width: 600px) {
            .build-card {
                grid-template-columns: 36px 1fr auto;
            }

            .build-card .recipe-cost {
                grid-column: 2;
            }

            .build-card .recipe-action {
                grid-column: 3;
                grid-row: 1 / span 2;
            }
        }

        #world-map-overlay {
            background: rgba(0, 0, 0, 0.96);
            gap: 12px;
            padding: 24px;
            box-sizing: border-box;
        }

        #world-map-overlay h2 {
            margin: 0;
            color: var(--gold);
            letter-spacing: 6px;
        }

        #world-map-canvas {
            width: min(88vw, 78vh);
            height: min(88vw, 78vh);
            image-rendering: pixelated;
            border: 1px solid #555;
            background: #000;
            cursor: grab;
            touch-action: none;
        }

        #world-map-canvas.dragging {
            cursor: grabbing;
        }

        #world-map-caption {
            color: #888;
            font-size: 0.7rem;
        }

        #world-map-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        #world-map-zoom-label {
            min-width: 50px;
            color: var(--gold);
            font-size: 0.7rem;
        }

        #chest-menu-overlay {
            background: rgba(0, 0, 0, 0.96);
            gap: 16px;
            padding: 24px;
            box-sizing: border-box;
        }

        #chest-menu-overlay h2 {
            margin: 0;
            color: var(--gold);
            letter-spacing: 6px;
        }

        #chest-storage-ui {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .storage-panel {
            min-width: 260px;
            background: #101010;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 12px;
        }

        .storage-panel-header {
            font-size: 0.7rem;
            color: var(--gold);
            letter-spacing: 2px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .storage-grid {
            display: grid;
            grid-template-columns: repeat(5, 52px);
            gap: 8px;
            justify-content: center;
        }

        .storage-slot {
            width: 52px;
            height: 52px;
            background: #111;
            border: 1px solid #444;
            border-radius: 6px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            cursor: pointer;
        }

        .storage-slot.empty {
            color: #555;
        }

        .storage-slot .count {
            position: absolute;
            right: 4px;
            bottom: 2px;
            font-size: 0.72rem;
            font-weight: 900;
        }

        .storage-slot.drag-over {
            border-color: var(--gold);
            box-shadow: 0 0 0 1px rgba(255, 204, 0, 0.5);
        }

        .chat-msg {
            opacity: 1;
            transition: opacity 0.5s ease, transform 0.5s ease;
            animation: chatFade 5s ease forwards;
        }

        @keyframes chatFade {
            0% {
                opacity: 1;
                transform: translateY(0);
            }

            80% {
                opacity: 1;
                transform: translateY(0);
            }

            100% {
                opacity: 0;
                transform: translateY(-2px);
            }
        }

        .console-popup {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 450px;
            background: var(--ui-bg);
            border: 2px solid var(--gold);
            padding: 30px;
            display: none;
            flex-direction: column;
            z-index: 900;
            border-radius: 8px;
            color: white;
        }

        .option-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #111;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 4px;
        }

        #mobile-controls {
            position: absolute;
            bottom: 40px;
            right: 40px;
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        #joystick {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
        }

        @media (max-width: 768px) {
            #mobile-controls {
                display: flex;
            }
        }

        #creative-panel {
            display: none;
            position: absolute;
            top: 262px;
            right: 20px;
            width: 270px;
            max-height: calc(100vh - 290px);
            overflow-y: auto;
            touch-action: pan-y;
            background: var(--ui-bg);
            border: 1px solid var(--gold);
            border-radius: 8px;
            padding: 12px;
            z-index: 1200;
            font-size: 0.7rem;
            color: #ccc;
        }

        #creative-panel .cp-title {
            color: var(--gold);
            font-weight: 900;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        #creative-panel .cp-label {
            color: var(--gold);
            font-size: 0.6rem;
            letter-spacing: 2px;
            margin: 10px 0 4px;
            display: flex;
            justify-content: space-between;
        }

        #creative-panel .cp-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 4px 0;
        }

        #creative-panel .cp-row span {
            flex: 1;
        }

        #creative-panel .cp-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
        }

        #creative-panel button {
            background: #111;
            color: #eee;
            border: 1px solid #444;
            border-radius: 4px;
            padding: 6px;
            cursor: pointer;
            font-size: 0.65rem;
            text-transform: uppercase;
        }

        #creative-panel button:hover {
            border-color: var(--gold);
            color: var(--gold);
        }

        #creative-panel input[type=number],
        #creative-panel select {
            background: #000;
            color: #fff;
            border: 1px solid #444;
            padding: 4px;
            min-width: 0;
        }

        #creative-panel input[type=number] {
            width: 60px;
        }

        #creative-panel .cp-hint {
            color: #777;
            font-size: 0.58rem;
            margin-top: 6px;
        }

        #cp-status {
            color: var(--success);
            min-height: 1.2em;
            margin-top: 8px;
            font-size: 0.62rem;
        }
    </style>
</head>

<body>
    <div id="game-container">
        <canvas id="gameCanvas"></canvas>

        <div id="clock-container" class="overlay" style="display:none;">
            <div id="day-count">DAY 1</div>
            <div id="phase-label">DAYLIGHT</div>
            <div id="phase-timer">04:00</div>
        </div>

        <div id="darkness-warning" aria-hidden="true"></div>

        <!-- SCREENS -->
        <div id="main-menu" class="screen">
            <h1>ALONE TOGETHER</h1>
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <button class="menu-btn primary" onclick="showInitialize()">PLAY</button>
                <button id="load-save-btn" class="menu-btn"
                    style="display:none; border-color:var(--success); color:var(--success);" onclick="loadGame()">RESUME
                    SECTOR</button>
                <button class="menu-btn" onclick="document.getElementById('save-file-input').click()">OPEN .SAVE
                    FILE</button>
                <button class="menu-btn" onclick="showTutorial()">TUTORIAL</button>
                <button class="menu-btn" onclick="showPatchNotes()">PATCH NOTES</button>
            </div>
            <div id="menu-quote"
                style="margin-top: 30px; font-style: italic; color: #888; font-size: 0.9rem; max-width: 450px; line-height: 1.4;">
            </div>
        </div>

        <div id="patch-notes-screen" class="screen" style="display:none;">
            <div class="settings-wrap" style="max-width:700px;">
                <h2>PATCH NOTES</h2>
                <div style="text-align:left; color:#ddd; font-size:0.74rem; line-height:1.7;">
                    <p>???</p>
                </div>
            </div>
            <button class="menu-btn primary" onclick="hidePatchNotes()">BACK</button>
        </div>

        <div id="init-choice" class="screen" style="display:none;">
            <h2>Select difficulty (?)</h2>
            <button class="menu-btn primary" onclick="prepareSettings('solo')">THE REAL GAME (ALONE)</button>
            <button class="menu-btn" onclick="showOnlineProfile()">ALONE TOGETHER (BETA)</button>
            <button class="menu-btn" onclick="resetGame()">BACK</button>
        </div>

        <div id="world-settings-screen" class="screen" style="display:none;">
            <h2>Your world, your rules</h2>

            <!-- Override Checkbox & Warning Block -->
            <div
                style="background: rgba(255,0,0,0.1); border: 1px solid #ff4444; padding: 10px; margin-bottom: 15px; border-radius: 4px; text-align: left;">
                <label
                    style="color: #ff4444; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="set-override-limits" onchange="toggleLimitOverride()"> OVERRIDE SLIDER
                    LIMITS
                </label>
                <div id="override-warning"
                    style="display: none; color: #ffaa00; font-size: 0.8rem; margin-top: 5px; line-height: 1.2;">
                    ⚠️ WARNING: Removing safety constraints allows ultra-high/low inputs. This can crash your browser,
                    cause intense lag, or break map generation logic. Proceed with caution.
                </div>
            </div>

            <div class="settings-wrap" id="settings-fields-container">
                <!-- Settings items are contained here -->
                <div class="setting-item" data-setting="res">
                    <span>RESOURCE DENSITY</span>
                    <div class="input-control"><input type="range" id="set-res" min="0.2" max="3.0" step="0.2"
                            value="1.0"></div>
                </div>
