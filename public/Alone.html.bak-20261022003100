                }

                setBlueprintFeedback('PASTE: NEED MATERIALS.');
                displayChat({
                    name: 'SYSTEM',
                    text: 'Insufficient resources.',
                    color: '#f00'
                });
                return;
            }

            if (worldConfig.creative || hasRes(BUILDINGS[key])) {

                if (BUILDINGS[key].type === 'item') {

                    if (!worldConfig.creative) {
