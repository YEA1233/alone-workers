        function toggleLimitOverride() {
            const isOverridden = document.getElementById('set-override-limits').checked;
            document.getElementById('override-warning').style.display = isOverridden ? 'block' : 'none';

            document.querySelectorAll('.setting-item[data-setting]').forEach(item => {
                const key = item.getAttribute('data-setting');
                const container = item.querySelector('.input-control');
                const oldInput = container.querySelector('input');
                const currentValue = oldInput ? oldInput.value : SETTING_METADATA[key].def;

                container.innerHTML = ''; // Wipe out existing control

                const newInput = document.createElement('input');
                newInput.id = `set-${key}`;
                newInput.value = currentValue;

                if (isOverridden) {
                    // Transform into an unrestricted custom numeric text box
                    newInput.type = 'number';
                    newInput.step = 'any';
                    newInput.style.cssText = "background:#000; color:#ff4444; border:1px solid #ff4444; padding:4px; width:80px; text-align:center; font-family:monospace;";
                } else {
                    // Restore standard restricted ranges safely
                    newInput.type = 'range';
                    newInput.min = SETTING_METADATA[key].min;
                    newInput.max = SETTING_METADATA[key].max;
                    newInput.step = SETTING_METADATA[key].step;

                    // Re-bind default sanitization boundaries if text input values exceed range bounds
                    if (Number(currentValue) > SETTING_METADATA[key].max) newInput.value = SETTING_METADATA[key].max;
                    if (Number(currentValue) < SETTING_METADATA[key].min) newInput.value = SETTING_METADATA[key].min;
                }

                container.appendChild(newInput);
            });
        }

        function connectToGameServer() {
            if (gameSocket) {
                try {
                    gameSocket.close();
                } catch { }
            }

            const room =
                encodeURIComponent(
                    onlineRoom || 'public'
                );

            setConnectionStatus(
                'CONNECTING...',
                '#ffcc00'
            );

            try {
                gameSocket =
                    new WebSocket(
                        `${GAME_SERVER_URL}?room=${room}`
                    );
            } catch (error) {
                console.error(
                    'WebSocket creation failed:',
                    error
                );

                setConnectionStatus(
                    'OFFLINE MODE',
                    '#ff4444'
                );

                return;
            }

            gameSocket.onopen = () => {

                setConnectionStatus(
                    'CONNECTED',
                    '#2ecc71'
                );

                /*
                 * IMPORTANT:
                 *
                 * Send the COMPLETE 28-character seed.
                 * Never send numeric worldSeed here.
                 */
                gameSocket.send(
                    JSON.stringify({
                        type: 'join',

                        roomId:
                            onlineRoom ||
                            'public',

                        roomName:
                            onlineRoom || '',

                        visibility:
                            pendingVisibility ||
                            'public',

                        playerId:
                            onlinePlayerId,

                        seed:
                            currentWorldSeed,

                        worldConfig: {
                            resMult:
                                worldConfig.resMult,

                            foodMult:
                                worldConfig.foodMult,

                            dayMult:
                                worldConfig.dayMult,

                            nightMult:
                                worldConfig.nightMult,

                            hungerMult:
                                worldConfig.hungerMult,

                            worldSizeMult:
                                worldConfig.worldSizeMult,

                            mapPreset:
                                worldConfig.mapPreset,

                            oceanMult:
                                worldConfig.oceanMult,

                            forestMult:
                                worldConfig.forestMult,

                            mountainMult:
                                worldConfig.mountainMult,

                            wildlifeMult:
                                worldConfig.wildlifeMult,

                            creative:
                                !!worldConfig.creative
                        },

                        player: {
                            x:
                                player.x,

                            y:
                                player.y,

                            hp:
                                player.hp,

                            hunger:
                                player.hunger,

                            emoji:
                                player.emoji,

                            color:
                                player.color,

                            name:
                                onlineName,

                            inventory:
                                Array.isArray(
                                    player.inventory
                                )
                                    ? player.inventory.map(
                                        slot => ({
                                            type:
                                                slot?.type ||
                                                null,

                                            count:
                                                Number(
                                                    slot?.count
                                                ) || 0
                                        })
                                    )
                                    : [],

                            inBoat:
                                !!player.inBoat,

                            boatId:
                                player.boatId ||
                                null
                        }
                    })
                );
            };


            gameSocket.onmessage = event => {

                let message;

                try {
                    message =
                        JSON.parse(
                            event.data
                        );
                } catch (error) {
                    console.error(
                        'Invalid server message:',
                        event.data
                    );
                    return;
                }

                // =====================================================
                // ROOM INITIALIZATION
                // =====================================================

                if (
                    message.type ===
                    'room:init'
                ) {

                    console.log(
                        'MULTIPLAYER ROOM INIT:',
                        message
                    );

                    /*
                     * The server is authoritative.
                     *
                     * Use its seed as a STRING.
                     */
                    if (
                        typeof message.seed ===
                        'string'
                    ) {

                        currentWorldSeed =
                            message.seed
                                .toUpperCase()
                                .replace(
                                    /[^A-Z0-9]/g,
                                    ''
                                );

                        console.log(
                            'SERVER WORLD SEED:',
                            formatWorldSeed(
                                currentWorldSeed
                            )
                        );
                    }

                    // -------------------------------------------------
                    // World configuration
                    // -------------------------------------------------

                    if (
                        message.worldConfig
                    ) {

                        worldConfig = {
                            ...worldConfig,
                            ...message.worldConfig
                        };
                    }

                    // -------------------------------------------------
                    // Dimensions
                    // -------------------------------------------------

                    if (
                        message.world
                    ) {

                        const world =
                            message.world;

                        if (
                            Number.isFinite(
                                world.rows
                            )
                        ) {
                            ROWS =
                                world.rows;
                        }

                        if (
                            Number.isFinite(
                                world.cols
                            )
                        ) {
                            COLS =
                                world.cols;
                        }

                        if (
                            Number.isFinite(
                                world.width
                            )
                        ) {
                            worldWidth =
                                world.width;
                        }

                        if (
                            Number.isFinite(
                                world.height
                            )
                        ) {
                            worldHeight =
                                world.height;
                        }

                        // -------------------------------------------------
                        // Decode authoritative terrain
                        // -------------------------------------------------

                        if (
                            Array.isArray(
                                world.terrain
                            )
                        ) {

                            worldGrid =
                                world.terrain.map(
                                    row =>
                                        String(row)
                                            .split(',')
                                );

                            mapTerrainDirty =
                                true;
                        }

                        // -------------------------------------------------
                        // Resources
                        // -------------------------------------------------

                        discoveredGrid = new Uint8Array(COLS * ROWS);
                        mapTerrainCanvas.width = COLS;
                        mapTerrainCanvas.height = ROWS;
                        mapTerrainDirty = true;

                        if (
                            Array.isArray(
                                world.resourceNodes
                            )
                        ) {

                            resourceNodes =
                                world.resourceNodes.map(
                                    node => ({
                                        ...node
                                    })
                                );
                        }

                        // -------------------------------------------------
                        // Wildlife
                        // -------------------------------------------------

                        if (
                            Array.isArray(
                                world.mobs
                            )
                        ) {

                            mobs =
                                world.mobs.map(
                                    mob => ({
                                        ...mob
                                    })
                                );
                        }

                        // -------------------------------------------------
                        // Buildings
                        // -------------------------------------------------

                        if (
                            Array.isArray(
                                world.buildings
                            )
                        ) {

                            buildings =
                                world.buildings.map(
                                    building => ({
                                        ...building,

                                        inventory:
                                            Array.isArray(
                                                building.inventory
                                            )
                                                ? building.inventory.map(
                                                    slot => ({
                                                        ...slot
                                                    })
                                                )
                                                : building.inventory
                                    })
                                );
                        }
                    }

                    // -------------------------------------------------
                    // Player ID
                    // -------------------------------------------------

                    if (
                        message.playerId
                    ) {

                        onlinePlayerId =
                            message.playerId;
                    }

                    // -------------------------------------------------
                    // Other players
                    // -------------------------------------------------

                    remotePlayers = {};
                    const me = Array.isArray(message.players) ? message.players.find(p => p && p.id === onlinePlayerId) : null;
                    if (me) { player.x = me.x; player.y = me.y; player.serverX = me.x; player.serverY = me.y; }

                    if (
                        Array.isArray(
                            message.players
                        )
                    ) {

                        for (
                            const remote
                            of message.players
                        ) {

                            if (
                                !remote ||
                                !remote.id ||
                                remote.id ===
                                onlinePlayerId
                            ) {
                                continue;
                            }

                            updateRemotePlayer(
                                remote.id,
                                remote
                            );
                        }
                    }

                    // -------------------------------------------------
                    // Refresh terrain canvas
                    // -------------------------------------------------

                    mapTerrainDirty =
                        true;

                    /*
                     * DO NOT call generateOrganicMap()
                     * here.
                     *
                     * The server already generated
                     * the authoritative world.
                     */

                    currentState =
                        'GAME';

                    startGameUI();

                    return;
                }


                // =====================================================
                // WORLD STATE
                // =====================================================

                if (
                    message.type ===
                    'world:state'
                ) {

                    if (
                        typeof message.seed ===
                        'string'
                    ) {

                        currentWorldSeed =
                            message.seed
                                .toUpperCase()
                                .replace(
                                    /[^A-Z0-9]/g,
                                    ''
                                );
                    }

                    if (
                        message.worldConfig
                    ) {

                        worldConfig = {
                            ...worldConfig,
                            ...message.worldConfig
                        };
                    }

                    if (
                        Number.isFinite(
                            message.dayCount
                        )
                    ) {
                        dayCount =
                            message.dayCount;
                    }

                    if (
                        Number.isFinite(
                            message.gameTime
                        )
                    ) {
                        gameTime =
                            message.gameTime;
                    }
                    if (typeof message.phase === 'string' && CYCLE[message.phase]) {
                        currentPhase = message.phase;
                        phaseTimeLeft = Math.round((Number(message.phaseTimeLeft) || 0) * 60);
                    }

                    // -------------------------------------------------
                    // Players
                    // -------------------------------------------------

                    if (
                        Array.isArray(
                            message.players
                        )
                    ) {

                        const seen =
                            new Set();

                        for (
                            const remote
                            of message.players
                        ) {

                            if (
                                !remote ||
                                !remote.id
                            ) {
                                continue;
                            }

                            if (
                                remote.id ===
                                onlinePlayerId
                            ) {

                                /*
                                 * Do not overwrite local
                                 * rendering state with the
                                 * server snapshot.
                                 *
                                 * Keep authoritative values
                                 * that matter.
                                 */
                                if (
                                    Number.isFinite(
                                        remote.hp
                                    )
                                ) {
                                    player.hp =
                                        remote.hp;
                                }

                                if (
                                    Number.isFinite(
                                        remote.hunger
                                    )
                                ) {
                                    player.hunger =
                                        remote.hunger;
                                }
                                if (Number.isFinite(remote.x) && Number.isFinite(remote.y)) { player.serverX = remote.x; player.serverY = remote.y; }
                                if (typeof remote.inBoat === 'boolean') player.inBoat = remote.inBoat;
                                player.boatId = remote.boatId || null;
                                continue;
                            }

                            seen.add(
                                remote.id
                            );

                            updateRemotePlayer(
                                remote.id,
                                remote
                            );
                        }

                        for (
                            const id
                            of Object.keys(
                                remotePlayers
                            )
                        ) {

                            if (
                                !seen.has(id)
                            ) {
                                delete remotePlayers[id];
                            }
                        }
                    }

                    // -------------------------------------------------
                    // World
                    // -------------------------------------------------

                    if (
                        message.world
                    ) {

                        if (
                            Array.isArray(
                                message.world.resourceNodes
                            )
                        ) {
                            resourceNodes =
                                message.world.resourceNodes;
                        }

                        if (
                            Array.isArray(
                                message.world.mobs
                            )
                        ) {
                            mobs =
                                message.world.mobs;
                        }

                        if (
                            Array.isArray(
                                message.world.buildings
                            )
                        ) {
                            buildings =
                                message.world.buildings;
                        }

                    }

                    return;
                }

                if (message.type === 'world:patch') {
                    const nodes = message.nodes || {};
                    if (nodes.del && nodes.del.length) {
                        const gone = new Set(nodes.del);
                        resourceNodes = resourceNodes.filter(n => !gone.has(n.id));
                    }
                    for (const node of nodes.set || []) {
                        const i = resourceNodes.findIndex(n => n.id === node.id);
                        if (i >= 0) resourceNodes[i] = node; else resourceNodes.push(node);
                    }
                    return;
                }

                if (message.type === 'world:fx') {
                    floatText(Number(message.x) || player.x, Number(message.y) || player.y, String(message.text || ''), message.color || '#ffffff');
                    return;
                }

                if (message.type === 'world:mobs') {
                    if (message.del && message.del.length) {
                        const gone = new Set(message.del);
                        mobs = mobs.filter(m => !gone.has(m.id));
                    }
                    for (const entry of message.set || []) {
                        const existing = mobs.find(m => m.id === entry.id);
                        if (existing) Object.assign(existing, entry);
                        else if (entry.type) mobs.push({ ...entry });
                    }
                    return;
                }
                // =====================================================
                // WORLD UPDATE
                // =====================================================

                if (
                    message.type ===
                    'world:update'
                ) {

                    const world =
                        message.world;

                    if (!world) return;

                    if (
                        Array.isArray(
                            world.resourceNodes
                        )
                    ) {
                        resourceNodes =
                            world.resourceNodes;
                    }

                    if (
                        Array.isArray(
                            world.mobs
                        )
                    ) {
                        mobs =
                            world.mobs;
                    }

                    if (
                        Array.isArray(
                            world.buildings
                        )
                    ) {
                        buildings =
                            world.buildings;
                    }

                    mapTerrainDirty =
                        true;

                    return;
                }


                // =====================================================
                // PLAYER UPDATE
                // =====================================================

                if (
                    message.type ===
                    'player:update'
                ) {

                    const id =
                        message.playerId ||
                        message.player?.id;

                    if (!id) return;

                    if (
                        id ===
                        onlinePlayerId
                    ) {

                        if (
                            message.player
                        ) {

                            if (
                                Number.isFinite(
                                    message.player.hp
                                )
                            ) {
                                player.hp =
                                    message.player.hp;
                            }

                            if (
                                Number.isFinite(
                                    message.player.hunger
                                )
                            ) {
                                player.hunger =
                                    message.player.hunger;
                            }

                            if (
                                Array.isArray(
                                    message.player.inventory
                                )
                            ) {

                                player.inventory =
                                    message.player.inventory.map(
                                        slot => ({
                                            ...slot
                                        })
                                    );

                                renderInventory();
                            }

                            if (
                                typeof
                                message.player.inBoat ===
                                'boolean'
                            ) {
                                player.inBoat =
                                    message.player.inBoat;
                            }

                            player.boatId =
                                message.player.boatId ||
                                null;
                        }

                        return;
                    }

                    updateRemotePlayer(
                        id,
                        message.player
                    );

                    return;
                }


                // =====================================================
                // PLAYER JOINED
                // =====================================================

                if (
                    message.type ===
                    'player:joined'
                ) {

                    const remote =
                        message.player;

                    if (
                        remote &&
                        remote.id &&
                        remote.id !==
                        onlinePlayerId
                    ) {

                        updateRemotePlayer(
                            remote.id,
                            remote
                        );
                    }

                    return;
                }


                // =====================================================
                // PLAYER LEFT
                // =====================================================

                if (
                    message.type ===
                    'player:left'
                ) {

                    if (
                        message.playerId
                    ) {

                        delete remotePlayers[
                            message.playerId
                        ];
                    }

                    return;
                }


                // =====================================================
                // WORLD ERROR
                // =====================================================

                if (
                    message.type ===
                    'world:error'
                ) {

                    displayChat({
                        name: 'SYSTEM',
                        text:
                            message.message ||
                            'World action rejected.',
                        color: '#ff4444'
                    });

                    return;
                }


                // =====================================================
                // CHAT
                // =====================================================

                if (
                    message.type ===
                    'chat:message'
                ) {

                    displayChat({
                        name:
                            message.name ||
                            'PLAYER',

                        text:
                            message.text ||
                            '',

                        color:
                            message.color ||
                            '#fff'
                    });

                    return;
                }


                // =====================================================
                // ERROR
                // =====================================================

                if (
                    message.type ===
                    'error'
                ) {

                    console.error(
                        'SERVER ERROR:',
                        message.message
                    );

                    displayChat({
                        name: 'SYSTEM',

                        text:
