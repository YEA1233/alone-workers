                    }

                    addToInv(key, 1);

                } else {

                    buildMode = key;
                    isPlacing = true;

                    document.getElementById('placement-label').innerText =
                        `PLACING ${BUILDINGS[key].name.toUpperCase()}`;

                    document.getElementById('placement-controls').style.display =
                        'flex';

                    displayChat({
                        name: 'SYSTEM',
                        text: `Click to place. Press X to stop.`,
                        color: '#888'
                    });
                }

                setBlueprintFeedback(`${BUILDINGS[key].name} ready.`);
                closeBuildMenu();

            } else {

                setBlueprintFeedback(
                    `${BUILDINGS[key].name}: NEED MATERIALS.`
                );

                displayChat({
                    name: 'SYSTEM',
                    text: `Insufficient resources.`,
                    color: '#f00'
                });
            }

        } // <-- THIS was missing

        function closeBuildMenu() { document.getElementById('build-menu-overlay').style.display = 'none'; }

        // CHEST UI: open a chest building and render drag & drop storage
        let _activeChestBuilding = null;
        function openChest(building) {
            if (!building || building.type !== 'chest') return;
            _activeChestBuilding = building;
            const overlay = document.getElementById('chest-menu-overlay');
            overlay.style.display = 'flex';
            renderChestUI();
        }

        function closeChest() {
            const overlay = document.getElementById('chest-menu-overlay');
            overlay.style.display = 'none';
            _activeChestBuilding = null;
        }

        function renderChestUI() {
            const chestGrid = document.getElementById('chest-storage-grid');
            const playerGrid = document.getElementById('player-storage-grid');
            if (!chestGrid || !playerGrid) return;

            // Clear
            chestGrid.innerHTML = '';
            playerGrid.innerHTML = '';

            // Ensure chest inventory exists and has 10 slots
            if (!_activeChestBuilding.inventory) _activeChestBuilding.inventory = Array.from({ length: 10 }, () => ({ type: null, count: 0 }));
            _activeChestBuilding.inventory = _activeChestBuilding.inventory.slice(0, 10);
            while (_activeChestBuilding.inventory.length < 10) _activeChestBuilding.inventory.push({ type: null, count: 0 });

            // Render chest slots
            _activeChestBuilding.inventory.forEach((slot, idx) => {
                const el = document.createElement('div');
                el.className = `storage-slot ${!slot.type ? 'empty' : ''}`;
                el.draggable = true;
                el.dataset.kind = 'chest';
                el.dataset.index = idx;
                el.innerText = slot.type ? (ITEM_ICONS[slot.type] || slot.type.toUpperCase().slice(0, 1)) : '';
                if (slot.count > 0) {
                    const c = document.createElement('div'); c.className = 'count'; c.innerText = slot.count; el.appendChild(c);
                }
                el.addEventListener('dragstart', handleSlotDragStart);
                el.addEventListener('dragover', handleSlotDragOver);
                el.addEventListener('drop', handleSlotDrop);
                chestGrid.appendChild(el);
            });

            // Render player slots (show hotbar + rest)
            player.inventory.forEach((slot, idx) => {
                const el = document.createElement('div');
                el.className = `storage-slot ${!slot.type ? 'empty' : ''}`;
                el.draggable = true;
                el.dataset.kind = 'player';
                el.dataset.index = idx;
                el.innerText = slot.type ? (ITEM_ICONS[slot.type] || slot.type.toUpperCase().slice(0, 1)) : '';
                if (slot.count > 0) { const c = document.createElement('div'); c.className = 'count'; c.innerText = slot.count; el.appendChild(c); }
                el.addEventListener('dragstart', handleSlotDragStart);
                el.addEventListener('dragover', handleSlotDragOver);
                el.addEventListener('drop', handleSlotDrop);
                playerGrid.appendChild(el);
            });
        }

        let _dragPayload = null;
        function handleSlotDragStart(e) {
            const el = e.currentTarget;
            const kind = el.dataset.kind;
            const idx = Number(el.dataset.index);
            _dragPayload = { kind, idx };
            e.dataTransfer.effectAllowed = 'move';
        }
        function handleSlotDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; e.currentTarget.classList.add('drag-over'); }
        function handleSlotDrop(e) {
            e.preventDefault();
            const target = e.currentTarget;
            target.classList.remove('drag-over');
            if (!_dragPayload) return;
            const from = _dragPayload;
            const toKind = target.dataset.kind;
            const toIdx = Number(target.dataset.index);

            transferBetweenSlots(from.kind, from.idx, toKind, toIdx);
            _dragPayload = null;
            renderChestUI();
        }

        function transferBetweenSlots(fromKind, fromIdx, toKind, toIdx) {
            // Server-authoritative transfer: send a chest_transfer action and wait for server sync
            if (!gameSocket || gameSocket.readyState !== WebSocket.OPEN) {
                if (!_activeChestBuilding) return;
                const from = fromKind === 'player' ? player.inventory : _activeChestBuilding.inventory;
                const to = toKind === 'player' ? player.inventory : _activeChestBuilding.inventory;
                if (!from[fromIdx]?.type || !to[toIdx]) return;
                const source = from[fromIdx], destination = to[toIdx];
                if (destination.type && destination.type === source.type && !BUILDINGS[source.type]?.durability && !BUILDINGS[source.type]?.duration) {
                    destination.count = (destination.count || 0) + (source.count || 0);
                    from[fromIdx] = { type: null, count: 0 };
                } else {
                    from[fromIdx] = destination;
                    to[toIdx] = source;
                }
                renderInventory();
                return;
            }
            const chestX = _activeChestBuilding?.x, chestY = _activeChestBuilding?.y;
            gameSocket.send(JSON.stringify({ type: 'world:action', playerId: onlinePlayerId, action: { type: 'chest_transfer', payload: { chestX, chestY, fromKind, fromIdx, toKind, toIdx } } }));
            // Optimistically close UI until server responds with authoritative update
            // closeChest(); // optional: keep open while waiting
        }

        // Close chest if clicking outside canvas (optional)
        document.addEventListener('keydown', e => { if (e.code === 'Escape' && document.getElementById('chest-menu-overlay')?.style.display === 'flex') closeChest(); });


        function cancelPlacement() {
            buildMode = 'none'; isPlacing = false;
            const controls = document.getElementById('placement-controls');
            if (controls) controls.style.display = 'none';
        }

        function updatePlacementMouse(e) {
            const rect = canvas.getBoundingClientRect();
            placementMouse = { x: Math.floor(((e.clientX - rect.left) / globalScale + camera.x) / 40) * 40, y: Math.floor(((e.clientY - rect.top) / globalScale + camera.y) / 40) * 40 };
        }

        function update() {
            if (currentState === 'MENU') return;
            if (document.hidden) {
                stopMovement();
                if (gameSocket && gameSocket.readyState === WebSocket.OPEN) {
                    gameSocket.send(JSON.stringify({ type: 'input:update', roomId: onlineRoom, playerId: onlinePlayerId, sequence: ++inputSequence, input: { keys: {} } }));
                }
                return;
            }
            if (currentState === 'PAUSED' || isAnyOverlayActive()) {
                // Online the world keeps running on the server, so keep telling it we're standing still.
                if (isOnlineActive() && (++overlayTick % 10) === 0) {
                    gameSocket.send(JSON.stringify({ type: 'input:update', roomId: onlineRoom, playerId: onlinePlayerId, sequence: ++inputSequence, input: { keys: {}, selected: selectedHotbarIndex } }));
                }
                return;
            }
            frameCount++; updateDiscovery();
            updateAutoTask();
            if (!gameSocket || gameSocket.readyState !== WebSocket.OPEN) {
                let dx = 0, dy = 0;
                if (keys['KeyW'] || keys['ArrowUp'] || autoKeys.up) dy -= 1;
                if (keys['KeyS'] || keys['ArrowDown'] || autoKeys.down) dy += 1;
                if (keys['KeyA'] || keys['ArrowLeft'] || autoKeys.left) dx -= 1;
                if (keys['KeyD'] || keys['ArrowRight'] || autoKeys.right) dx += 1;
                if (dx || dy) {
                    const magnitude = Math.hypot(dx, dy);
                    const speed = PLAYER_SPEED * creativeSpeedMult * (['LAKE', 'RIVER', 'SHALLOW_WATER'].includes(getBiomeAtWorldPos(player.x, player.y)) ? 0.5 : 1);
                    const rawX = player.x + (dx / magnitude) * speed;
                    const rawY = player.y + (dy / magnitude) * speed;
                    const nextX = wrapWorldCoordinate(rawX, worldWidth);
                    const nextY = wrapWorldCoordinate(rawY, worldHeight);
                    if (nextX !== rawX || !isLocationBlocked(nextX, player.y)) player.x = nextX;
                    if (nextY !== rawY || !isLocationBlocked(player.x, nextY)) player.y = nextY;
                }
            }
            if (isOnlineActive() && player.serverX != null) {
                const dx = player.serverX - player.x, dy = player.serverY - player.y;
                if (Math.hypot(dx, dy) > 200) { player.x = player.serverX; player.y = player.serverY; }   // respawn / teleport
                else { player.x += dx * 0.4; player.y += dy * 0.4; }
            }
            if (worldConfig.creative) {
                player.hp = 100;
                player.hunger = 100;
                darknessExposure = 0;
            }
            Object.values(remotePlayers).forEach(other => { other.renderX += (other.targetX - other.renderX) * 0.25; other.renderY += (other.targetY - other.renderY) * 0.25; });
            if (!creativeFreezeTime) if (!isOnlineActive()) phaseTimeLeft--;
            if (!isOnlineActive() && phaseTimeLeft <= 0) {
                if (currentPhase === 'DAY') currentPhase = 'DUSK';
                else if (currentPhase === 'DUSK') currentPhase = 'NIGHT';
                else { currentPhase = 'DAY'; dayCount++; wolfWaveSpawned = false; resourceNodes.forEach(node => { if (node.type === 'sapling' && dayCount >= node.plantedDay) { node.type = 'wood'; node.icon = '🌲'; node.hp = 5; node.maxHp = 5; } }); }
                phaseTimeLeft = CYCLE[currentPhase].length * (currentPhase === 'DAY' ? worldConfig.dayMult : worldConfig.nightMult);
            }

            if (currentPhase === 'NIGHT' && dayCount >= 3 && !wolfWaveSpawned && !isOnlineActive()) {
                const count = Math.floor(dayCount / 2 * worldConfig.wildlifeMult);
                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    mobs.push({ type: 'wolf', x: player.x + Math.cos(angle) * 900, y: player.y + Math.sin(angle) * 900, emoji: '🐺', hp: 15 + (dayCount * 3), maxHp: 15 + (dayCount * 3), speed: 2.2 + (dayCount * 0.1), damage: 4 + Math.floor(dayCount / 4) });
                }
                wolfWaveSpawned = true;
                displayChat({ name: 'SYSTEM', text: 'Howling echoes through the sector...', color: '#ff4444' });
            }

            if (getActiveItem().type === 'torch' && !isOnlineActive()) {
                if (!worldConfig.creative) getActiveItem().duration--;
                if (getActiveItem().duration <= 0 && !worldConfig.creative) { getActiveItem().type = null; getActiveItem().count = 0; getActiveItem().duration = 0; getActiveItem().maxDuration = 0; displayChat({ name: 'SYSTEM', text: `Your torch burnt out!`, color: '#f00' }); }
                if (frameCount % 30 === 0) renderInventory();
            }



            if (!isOnlineActive()) mobs.forEach((m, idx) => {
                if (m.type === 'wolf') {
                    let dx = player.x - m.x, dy = player.y - m.y, dist = Math.sqrt(dx * dx + dy * dy);
                    const nearFire = buildings.some(b => b.type === 'campfire' && Math.sqrt((m.x - b.x) ** 2 + (m.y - b.y) ** 2) < 200);
                    if (nearFire) { m.x -= (dx / dist) * m.speed; m.y -= (dy / dist) * m.speed; } else if (dist > 10) { m.x += (dx / dist) * m.speed; m.y += (dy / dist) * m.speed; }
                    if (dist < 40 && frameCount % 40 === 0) damagePlayer(m.damage);
                } else {
                    if (Math.random() < 0.01) {
                        const ntx = m.x + (Math.random() - 0.5) * 150, nty = m.y + (Math.random() - 0.5) * 150;
                        const b = getBiomeAtWorldPos(ntx, nty);
                        if (BIOMES[b]?.passable && !['LAKE', 'RIVER', 'SHALLOW_WATER', 'BAY', 'GULF'].includes(b)) { m.tx = ntx; m.ty = nty; }
                    }
                    let dx = (m.tx || m.x) - m.x, dy = (m.ty || m.y) - m.y, dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist > 1) { m.x += (dx / dist) * 0.5; m.y += (dy / dist) * 0.5; }
                }
            });

            // In multiplayer, movement/harvest/interaction is server-authoritative.
            if (!player.isDowned) {
                // Disembark handled by server; client can request disembark
                if (keys['Space'] && player.inBoat && frameCount % 12 === 0 && gameSocket && gameSocket.readyState === WebSocket.OPEN) {
                    gameSocket.send(JSON.stringify({ type: 'world:action', playerId: onlinePlayerId, action: { type: 'disembark' } }));
                }
                // Hunger and creative still handled client-side for solo; in multiplayer server will send hunger/hp updates
            }

            if (player.hp <= 0 && !gameSocket) { resetGame(); }

            if (!worldConfig.creative && currentPhase === 'NIGHT' && !isOnlineActive()) {
                const campfire = buildings.some(b => b.type === 'campfire' && Math.sqrt((player.x - b.x - 20) ** 2 + (player.y - b.y - 20) ** 2) < 250);
                const torch = getActiveItem().type === 'torch';
                if (!campfire && !torch) darknessExposure++;
            }

            const hungerBox = document.getElementById('hunger-box');
            const hungerLabel = document.getElementById('hunger-label');
            const survivalAlert = document.getElementById('survival-alert');
            const nextHungerAlert = player.hunger <= 0 ? 3 : player.hunger <= 20 ? 2 : player.hunger <= 50 ? 1 : 0;
            if (nextHungerAlert !== hungerAlertLevel) {
                hungerAlertLevel = nextHungerAlert;
                if (hungerAlertLevel === 3) displayChat({ name: 'SYSTEM', text: 'STARVING: health is draining.', color: '#ff4444' });
                else if (hungerAlertLevel === 2) displayChat({ name: 'SYSTEM', text: 'CRITICAL HUNGER: eat something.', color: '#ff4444' });
                else if (hungerAlertLevel === 1) displayChat({ name: 'SYSTEM', text: 'Hunger is getting low.', color: '#ffa500' });
            }
            hungerBox.classList.toggle('warning', hungerAlertLevel === 1);
            hungerBox.classList.toggle('critical', hungerAlertLevel >= 2);
            hungerLabel.innerText = hungerAlertLevel >= 2 ? 'STARVING' : hungerAlertLevel === 1 ? 'HUNGER LOW' : 'HUNGER';
            survivalAlert.style.display = hungerAlertLevel >= 2 ? 'block' : 'none';
            survivalAlert.innerText = hungerAlertLevel === 3 ? 'Health draining' : hungerAlertLevel === 2 ? 'Find food now' : '';

            if (darknessExposure >= 8 * 60) damagePlayer(7 / 60);
            if (darknessExposure >= 8 * 60 && frameCount % 60 === 0) displayChat({ name: 'SYSTEM', text: 'The darkness is hurting you.', color: '#ff4444' });
            if (gameSocket && gameSocket.readyState === WebSocket.OPEN && frameCount % 3 === 0) gameSocket.send(JSON.stringify({ type: 'input:update', roomId: onlineRoom, playerId: onlinePlayerId, sequence: ++inputSequence, input: { keys: effectiveKeys(), selected: selectedHotbarIndex } }));
            document.getElementById('darkness-warning').style.display = 'none';

            camera.x = Math.max(0, Math.min(worldWidth - logicalWidth, player.x - logicalWidth / 2));
            camera.y = Math.max(0, Math.min(worldHeight - logicalHeight, player.y - logicalHeight / 2));
            buildings = buildings.filter(b => b.type !== 'campfire' || --b.life > 0);
            document.getElementById('hp-val').innerText = Math.ceil(player.hp);
            document.getElementById('hunger-val').innerText = Math.ceil(player.hunger);
            document.getElementById('day-count').innerText = `DAY ${dayCount}`;
